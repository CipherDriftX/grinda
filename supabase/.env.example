# Edge Function secrets: `supabase secrets set --env-file supabase/.env`
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are set by Supabase.)

# Whop (whop.com/dashboard > Developer). Start in the sandbox; switch all five together.
WHOP_ENVIRONMENT=sandbox                    # sandbox | production
WHOP_API_KEY=apik_...                       # company API key with payments, transfers and webhooks
WHOP_ACCOUNT_ID=biz_...                     # your company id: checkouts are made and transfers are sent from it
WHOP_PRODUCT_ID=                            # optional: a hidden product the checkouts hang under
WHOP_REDIRECT_URL=https://steppie.app/paid.html  # site/paid.html: sends the buyer back into the app
WHOP_WEBHOOK_SECRET=ws_...                  # Developer > Webhooks: endpoint .../functions/v1/whop-webhook

# Who may pay. A lawyer fills these; in production an unset BLOCKED_REGIONS stops paid races.
BLOCKED_REGIONS=none                        # e.g. CZ,US-AZ,US-WA  (ISO country or country-state codes)
AGE_RULES=                                  # e.g. US-AL:19,US-MS:21  (only where the minimum is above 18)

# settle runs every 15 minutes from pg_cron with this header.
CRON_SECRET=generate-a-long-random-string
# admin-review (the review desk). 24+ characters; never ship it in the app.
ADMIN_SECRET=generate-another-long-random-string

# App Store Server API (Pro and Shields): App Store Connect > Users and Access > Integrations > In-App Purchase
APPSTORE_KEY_ID=ABC123DEFG
APPSTORE_ISSUER_ID=00000000-0000-0000-0000-000000000000
APPSTORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPSTORE_BUNDLE_ID=com.cipherdriftx.steppie
