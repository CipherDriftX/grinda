# Grinda release lanes. Authentication uses an App Store Connect API key
# (no Apple ID password, no 2FA prompts), so they run unattended in CI.
#
# Env: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64, APPLE_TEAM_ID
default_platform(:ios)

platform :ios do
  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  def key_path
    path = File.expand_path("../build/asc_key.p8", __dir__)
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64")))
    path
  end

  desc "Build, sign (automatic, cloud-managed) and upload to TestFlight"
  lane :beta do
    api_key = asc_key
    latest = latest_testflight_build_number(api_key: api_key, initial_build_number: 0)
    increment_build_number(xcodeproj: "Grinda.xcodeproj", build_number: latest + 1)
    build_app(
      project: "Grinda.xcodeproj",
      scheme: "Grinda",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/release",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key_path}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
        "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
        "CODE_SIGN_STYLE=Automatic"
      ].join(" ")
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Upload App Store metadata and screenshots (no binary, no submission)"
  lane :metadata do
    upload_to_app_store(
      api_key: asc_key,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      screenshots_path: "fastlane/screenshots",
      metadata_path: "fastlane/metadata",
      force: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Submit the latest TestFlight build for App Review"
  lane :release do
    upload_to_app_store(
      api_key: asc_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      metadata_path: "fastlane/metadata",
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end
end
